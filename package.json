{
  "name": "isabella-aigner-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint --ext .js,.ts,.vue src",
    "format": "prettier --write \"src/**/*.{js,ts,vue,css,scss,html}\""
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@tailwindcss/vite": "4.2.1",
    "@vueuse/core": "13.1.0",
    "@vueuse/motion": "^3.0.3",
    "gsap": "3.14.2",
    "primeicons": "6.0.1",
    "primevue": "3.53.1",
    "vue": "3.5.30",
    "vue-i18n": "11.3.0",
    "vue-router": "4.5.0"
  },
  "overrides": {
    "vite-plugin-image-presets": {
      "sharp": "^0.34.5"
    }
  },
  "devDependencies": {
    "@tailwindcss/forms": "0.5.11",
    "@vitejs/plugin-vue": "5.2.3",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "happy-dom": "20.8.3",
    "jsdom": "26.1.0",
    "prettier": "3.8.1",
    "sass": "1.97.3",
    "sharp": "0.34.5",
    "svgo": "^4.0.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.8.3",
    "vite": "6.4.1",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-image-presets": "0.3.4",
    "vitest": "3.1.1",
    "vue-tsc": "2.2.8"
  }
